# dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# local environment (the committed template is .env.example)
.env
.env.*
!.env.example

# editor / OS noise
.DS_Store
.idea/
.vscode/
*.log

# personal Claude Code settings (the shared ones live in .claude/settings.json)
.claude/settings.local.json
# git worktrees a Claude Code session opens for isolated work (whole checkouts, never committed)
.claude/worktrees/

# local scratch: anything that must not reach the submission
# (study notes, throwaway drafts, downloaded reference material)
.local/
