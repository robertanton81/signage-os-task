# Copy to .env for local overrides; docker compose sets these for the containers.
# The key set is finalised in TODO step 2 (shared configuration). Values are intentionally empty.

# RabbitMQ connection string used by ingest and processing
RABBITMQ_URL=
# MongoDB connection string used by processing
MONGODB_URL=
# Log level for every service (debug | info | warn | error)
LOG_LEVEL=
# Address and port the ingest socket server listens on
INGEST_HOST=
INGEST_PORT=
# Number of emulated devices and the interval between events per device
EMULATOR_DEVICE_COUNT=
EMULATOR_EVENT_INTERVAL_MS=
